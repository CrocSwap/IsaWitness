+import Sail
+
+namespace SailTests.NatConversions
+
+def Mixed (n : Nat) (z : Int) : Prop := n - z = z
+example : ¬ Mixed 0 (-1) := by unfold Mixed; decide
+example : Sail.Int.toNatChecked (37 : Int) = 37 := by decide
+example (n : Int) (h : 0 ≤ n) : Sail.Int.toNatChecked n = n.toNat :=
+  Sail.Int.toNatChecked_of_nonneg n h
+
+namespace OptIn
+open scoped Sail.LossyInt
+def LegacyMixed (n : Nat) (z : Int) : Prop := n - z = z
+example : LegacyMixed 0 (-1) := by unfold LegacyMixed; decide
+end OptIn
+
+end SailTests.NatConversions
