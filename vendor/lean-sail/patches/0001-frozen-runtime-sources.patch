+++ b/SailTests/SetSliceInt.lean
@@ -0,0 +1,54 @@
+import Sail
+/-! Unit tests for `Sail.set_slice_int` / `Sail.get_slice_int` against Sail's reference
+semantics (lib/sail.c `set_slice_int`: `mpz_set` then per-bit `mpz_setbit`/`mpz_clrbit`,
+GMP's infinite two's-complement view for negative integers). Regression for L4
+(the old definition truncated `n` to `len` bits first: `set_slice_int 1 8388608 0 1#1 = -1`). -/
+
+namespace SailTests.SetSliceInt
+open Sail
+set_option maxRecDepth 100000
+
+/-- Bit `k` of `n` in the infinite two's-complement view (GMP `mpz_tstbit`). -/
+def refTstBit (n : Int) (k : Nat) : Bool := (n / 2 ^ k) % 2 == 1
+
+/-- GMP `mpz_setbit` / `mpz_clrbit`. -/
+def refPutBit (n : Int) (k : Nat) (b : Bool) : Int :=
+  if refTstBit n k == b then n else if b then n + 2 ^ k else n - 2 ^ k
+
+/-- Literal transcription of sail.c `set_slice_int`. -/
+def refSetSliceInt (len : Nat) (n : Int) (lo : Nat) (x : BitVec len) : Int :=
+  (List.range len).foldl (fun r i => refPutBit r (lo + i) (x.getLsbD i)) n
+
+-- The L4 regression (FPRoundBase odd rounding: `int_mant[0] = '1'` on 2^23).
+example : set_slice_int 1 8388608 0 1#1 = 8388609 := by rfl
+example : set_slice_int 1 8388609 0 0#1 = 8388608 := by rfl
+-- Field in the middle, wider than the old truncation width.
+example : set_slice_int 4 0x12345 4 0xA#4 = 0x123A5 := by rfl
+-- Negative integers: two's-complement view, sign extension preserved.
+example : set_slice_int 1 (-1) 0 0#1 = -2 := by rfl
+example : set_slice_int 8 (-1) 8 0#8 = -65281 := by rfl
+example : set_slice_int 4 (-16) 0 0xF#4 = -1 := by rfl
+example : set_slice_int 3 (-5) 2 0#3 = -29 := by rfl
+-- Zero-length slice is the identity.
+example : set_slice_int 0 (-12345) 7 0#0 = -12345 := by rfl
+
+-- Exhaustive small-range agreement with the sail.c transcription.
+#guard Id.run do
+  let mut ok := true
+  for len in List.range 5 do
+    for lo in List.range 6 do
+      for k in List.range 141 do
+        let n : Int := (k : Int) - 70
+        for v in List.range (2 ^ len) do
+          let x := BitVec.ofNat len v
+          if set_slice_int len n lo x != refSetSliceInt len n lo x then ok := false
+          -- round trip through get_slice_int
+          if get_slice_int len (set_slice_int len n lo x) lo != x then ok := false
+  return ok
+
+-- Large magnitudes (beyond 64 bits), both signs.
+#guard [((2 : Int) ^ 100 + 12345), -((2 : Int) ^ 100) - 77, (2 : Int) ^ 70 - 1, -1].all fun n =>
+  [(0, 0xFF#8), (60, 0x5A#8), (95, 0x81#8)].all fun (lo, x) =>
+    set_slice_int 8 n lo x == refSetSliceInt 8 n lo x
+
+end SailTests.SetSliceInt
