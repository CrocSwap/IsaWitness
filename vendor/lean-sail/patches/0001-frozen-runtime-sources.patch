+import Sail
+/-! L5 / C13: width coercions are not in scope with `open Sail` (what generated model code does), so
+width mismatches are elaboration errors; `Sail.BitVec.castWidth` is the explicit, checked cast. -/
+
+namespace SailTests.Widths
+open Sail
+
+-- No implicit resize between different widths (was `CoeT (BitVec n) x (BitVec m) := x.setWidth m`).
+#check_failure (fun (x : BitVec 32) => (x : BitVec 31))
+#check_failure (fun (x : BitVec 8) => (x : BitVec 16))
+-- No mixed-width operators (were `HAdd (BitVec n) (BitVec m) (BitVec n)` etc. via the coercion).
+#check_failure (fun (x : BitVec 8) (y : BitVec 4) => x + y)
+#check_failure (fun (x : BitVec 8) (y : BitVec 4) => x ^^^ y)
+
+-- Explicit opt-in still available to hand-written code.
+section
+open scoped Sail.LossyWidth
+example (x : BitVec 8) : BitVec 4 := x
+end
+
+-- castWidth is the identity when the widths agree (definitionally, and as a simp lemma).
+example (x : BitVec 8) : Sail.BitVec.castWidth (m := 8) x = x := by simp
+example (n : Nat) (x : BitVec n) : Sail.BitVec.castWidth (m := n) x = x := Sail.BitVec.castWidth_eq x
+#guard Sail.BitVec.castWidth (m := 8) (0xAB#8) == 0xAB#8
+-- widths equal but written differently (the generator's use): Lean checks them by evaluation
+example (x : BitVec (31 - 0 + 1)) : Sail.BitVec.castWidth (m := 32) x = x := by simp
+
+end SailTests.Widths
