namespace ArmFull

variable {real : Type} [Sail.SailReal real]

/-- Sail register initialization under the supplied oracle. Errors are propagated. -/
def initialState (oracle : Sail.ConcurrencyInterfaceV1.Oracle) :
    EStateM.Result (Sail.Error exception)
      (Sail.ConcurrencyInterfaceV1.SequentialState Regs Sail.ConcurrencyInterfaceV1.oracleChoiceSource) Unit :=
  (Functions.sail_model_init ()).run
    { (default : Sail.ConcurrencyInterfaceV1.SequentialState Regs Sail.ConcurrencyInterfaceV1.oracleChoiceSource)
      with choiceState := (oracle, 0) }

end ArmFull
