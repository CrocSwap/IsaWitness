import ArmFull
/-! GENERATED by generate.py. Values are excluded from memory observations. The frozen event-hook order is retained.
No claim that these projections prove secret independence or microarchitectural timing. -/
namespace ObsGen
open Sail Sail.ConcurrencyInterfaceV1 ArmFull
abbrev State := SequentialState Regs oracleChoiceSource
abbrev Ev := Sail.ConcurrencyInterfaceV1.Event
inductive Dir | read | write | fetch
  deriving DecidableEq, Repr
structure MemObs where
  dir : Dir
  va : Option Nat
  pa : Nat
  size : Nat
  kind : Access_kind arm_acc_type
  tag : Bool
inductive Obs
  | mem (a : MemObs)
  | barrier (b : Barrier)
  | barrierExt (desc : String)
  | cacheOp (c : CacheRecord)
  | tlbi (t : TLBIInfo)
  | takeException (f : Option FaultRecord)
  | returnException (pa : BitVec 56)
def Obs.ofEvent : Ev → Option Obs
  | .memRead pa n va k tag => some (.mem ⟨(match k with | .AK_ifetch _ => .fetch | _ => .read), va, pa, n, k, tag⟩)
  | .memWrite pa n va k _value tag => some (.mem ⟨.write, va, pa, n, k, tag.isSome⟩)
  | .barrier b => some (.barrier b)
  | .barrierExt d => some (.barrierExt d)
  | .cacheOp c => some (.cacheOp c)
  | .tlbi t => some (.tlbi t)
  | .takeException f => some (.takeException f)
  | .returnException pa => some (.returnException pa)
  | .translationStart _ => none
  | .translationEnd _ => none
def stateOf : EStateM.Result ε State α → State
  | .ok _ s => s
  | .error _ s => s
def delta (pre post : State) : List Ev :=
  (post.events.extract pre.events.size post.events.size).toList
structure Control where
  branchTaken : Bool
  pc : BitVec 64
  fallthroughPC : BitVec 64
  btype : BitVec 2
  btypeNext : BitVec 2
structure Policy where
  ditBefore : BitVec 1
  ditAfter : BitVec 1
  ssbsBefore : BitVec 1
  ssbsAfter : BitVec 1
def controlOf (post : State) : Control :=
  ⟨post.regs.__BranchTaken, post.regs._PC, post.regs._PC + 4,
   post.regs.PSTATE.BTYPE, post.regs.BTypeNext⟩
def policyOf (pre post : State) : Policy :=
  ⟨pre.regs.PSTATE.DIT, post.regs.PSTATE.DIT, pre.regs.PSTATE.SSBS, post.regs.PSTATE.SSBS⟩
structure Observation where
  events : List Obs
  control : Control
  policy : Policy
  error : Option (Sail.Error exception)
def errorOf : EStateM.Result (Sail.Error exception) State α → Option (Sail.Error exception)
  | .ok _ _ => none
  | .error e _ => some e
def observe (m : SailM α) (pre : State) : Observation :=
  let result := m pre
  let post := stateOf result
  ⟨(delta pre post).filterMap Obs.ofEvent, controlOf post, policyOf pre post, errorOf result⟩
def CT0Step (m : SailM α) (Public : State → State → Prop) : Prop :=
  ∀ s₁ s₂, Public s₁ s₂ → observe m s₁ = observe m s₂
theorem observe_events (m : SailM α) (s : State) :
    (observe m s).events = (delta s (stateOf (m s))).filterMap Obs.ofEvent := rfl
end ObsGen
