import ObsGen.Interface
/-! GENERATED by generate_arch.py. PROVISIONAL architectural projection for review.
Full raw observations remain in ObsGen.Interface. No CT0/CT1/CT2 guarantee is established by these projection equations.
Fault view retains occurrence, source fault status, target EL, ESR exception class/abort FSC,
read/write direction and a defined/masked VA. Internal FaultRecord bookkeeping is excluded.
FAR selection follows AArch64_ReportException/FAR_set; classification follows AArch64_ExceptionClass.
These equations certify this exact projection, not completeness of the proposed leakage contract. -/
namespace ObsGen.Arch
open Sail ArmFull
structure MaskedVA where
  value : BitVec 64
  definedMask : BitVec 64
  deriving Repr
structure FaultView where
  sourceStatus : Option Fault
  targetEL : BitVec 2
  exceptionClass : Option (BitVec 6)
  abortStatus : Option (BitVec 6)
  write : Option Bool
  va : Option MaskedVA
  deriving Repr

def esrOf (post : State) : Option (BitVec 64) :=
  match post.regs.PSTATE.EL.toNat with
  | 1 => some (post.regs.bank_BitVec_64 .ESR_EL1)
  | 2 => some (post.regs.bank_BitVec_64 .ESR_EL2)
  | 3 => some (post.regs.bank_BitVec_64 .ESR_EL3)
  | _ => none

def farOf (post : State) : Option (BitVec 64) :=
  match post.regs.PSTATE.EL.toNat with
  | 1 => some (post.regs.bank_BitVec_64 .FAR_EL1)
  | 2 => some (post.regs.bank_BitVec_64 .FAR_EL2)
  | 3 => some (post.regs.bank_BitVec_64 .FAR_EL3)
  | _ => none

def isAbortEC (ec : Nat) : Bool := [0x20, 0x21, 0x24, 0x25].contains ec

def hasDefinedFAR (esr : BitVec 64) : Bool :=
  let ec := (esr.extractLsb' 26 6).toNat
  let fnvClass := isAbortEC ec || [0x34, 0x35].contains ec
  [0x1e, 0x20, 0x21, 0x22, 0x24, 0x25, 0x34, 0x35].contains ec &&
    (!fnvClass || (esr.extractLsb' 10 1).toNat == 0)

def hasMTE4 (post : State) : Bool :=
  post.regs.FeatureImpl[(Functions.num_of_Feature .FEAT_MTE4).toNat]!

def vaMask (post : State) (fault : Option FaultRecord) : BitVec 64 :=
  match fault with
  | some f => if f.statuscode == .Fault_TagCheck && !hasMTE4 post
      then 0x0fffffffffffffff#64 else 0xffffffffffffffff#64
  | none => 0xffffffffffffffff#64

def faultView (post : State) (fault : Option FaultRecord) : FaultView :=
  let esr := esrOf post
  let ec := esr.map (fun e => e.extractLsb' 26 6)
  let fsc := esr.bind (fun e => if isAbortEC (e.extractLsb' 26 6).toNat
    then some (e.extractLsb' 0 6) else none)
  let va := esr.bind (fun e => if hasDefinedFAR e then
    (farOf post).map (fun a => ⟨a &&& vaMask post fault, vaMask post fault⟩) else none)
  ⟨fault.map (·.statuscode), post.regs.PSTATE.EL, ec, fsc, fault.map (·.write), va⟩

inductive Event
  | mem (a : MemObs)
  | barrier (b : Barrier)
  | barrierExt (desc : String)
  | cacheOp (c : CacheRecord)
  | tlbi (t : TLBIInfo)
  | takeException (f : FaultView)
  | returnException (pa : BitVec 56)

def projectEvent (post : State) : Obs → Event
  | .mem a => .mem a
  | .barrier b => .barrier b
  | .barrierExt d => .barrierExt d
  | .cacheOp c => .cacheOp c
  | .tlbi t => .tlbi t
  | .takeException f => .takeException (faultView post f)
  | .returnException pa => .returnException pa

structure Control where
  branchTaken : Bool
  branchKind : Option BranchType
  modelPC : BitVec 64
  nextPC : Option (BitVec 64)
  btype : BitVec 2
  relevantBtypeNext : Option (BitVec 2)

def isBTIWord (post : State) : Bool :=
  post.regs.__ThisInstrEnc == .__A64 &&
    ((post.regs.bank_BitVec_32 .__ThisInstr) &&& 0xffffff3f#32) == 0xd503241f#32

def relevantBtype (pre post : State) : Bool :=
  post.regs.__BranchTaken || (isBTIWord post && pre.regs.PSTATE.BTYPE.toNat != 0)

inductive Stage | clause | completed

def nextPC (stage : Stage) (post : State) (raw : ObsGen.Observation) : Option (BitVec 64) :=
  match raw.error with
  | some (.User (.Error_ExceptionTaken _)) => some raw.control.pc
  | some _ => none
  | none => match stage with
    | .completed => some raw.control.pc
    | .clause => if raw.control.branchTaken then some raw.control.pc else
        if post.regs.__ThisInstrEnc == .__A64 then some raw.control.fallthroughPC else none

structure Observation where
  events : List Event
  control : Control
  policy : Policy
  error : Option (Sail.Error exception)

def project (stage : Stage) (pre post : State) (raw : ObsGen.Observation) : Observation :=
  ⟨raw.events.map (projectEvent post),
    ⟨raw.control.branchTaken, (if post.regs.__BranchTaken then some post.regs.Branchtypetaken else none), raw.control.pc, nextPC stage post raw, raw.control.btype,
      if relevantBtype pre post then some raw.control.btypeNext else none⟩,
    raw.policy, raw.error⟩

def observe (m : SailM α) (pre : State) : Observation :=
  project .clause pre (stateOf (m pre)) (ObsGen.observe m pre)

theorem memory_projection (post : State) (a : MemObs) :
    projectEvent post (.mem a) = .mem a := rfl

theorem fault_occurrence (post : State) (f : Option FaultRecord) :
    projectEvent post (.takeException f) = .takeException (faultView post f) := rfl

theorem preserves_event_count (stage : Stage) (pre post : State) (raw : ObsGen.Observation) :
    (project stage pre post raw).events.length = raw.events.length := by
  simp only [project, List.length_map]

theorem retains_fault_status (post : State) (f : FaultRecord) :
    (faultView post (some f)).sourceStatus = some f.statuscode := rfl

theorem retains_policy (stage : Stage) (pre post : State) (raw : ObsGen.Observation) :
    (project stage pre post raw).policy = raw.policy := rfl

end ObsGen.Arch
